# Normalize line endings across platforms (Windows dev -> Linux CI/Docker)
* text=auto eol=lf

# Ensure shell scripts and workflows always use LF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files — never normalize
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
