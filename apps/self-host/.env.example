# SQLite database — stored next to the schema; Docker persists it in /data (PRD §8.5.2)
DATABASE_URL="file:./prdgenz.db"

# AI provider keys — self-host configures keys via env, not the UI (PRD §6.2.2)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
OMNIROUTE_API_KEY=""
TOKENROUTER_API_KEY=""
9ROUTER_API_KEY=""
# Docker Compose requires an interpolation name that starts with a letter.
# Set this for Docker; Compose passes it to the app as 9ROUTER_API_KEY.
NINEROUTER_API_KEY=""
CUSTOM_API_KEY=""
CUSTOM_BASE_URL=""

# Optional: default provider/model + output language (ID|EN)
AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL=""
AI_DEFAULT_LANGUAGE="EN"

# Set to 1 to allow CUSTOM_BASE_URL to point at a private address.
# The Docker image runs as production, so without this a local model server
# (Ollama on host.docker.internal:11434, LM Studio, vLLM on your LAN) is
# rejected by the SSRF guard. Only enable this on a network you control and
# where no untrusted person can submit a base URL. Leave unset on the cloud
# app, where any signed-up user can set one.
# ALLOW_PRIVATE_AI_HOSTS="1"
