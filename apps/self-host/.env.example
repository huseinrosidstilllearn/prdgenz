# SQLite database — stored next to the schema; Docker persists it in /data (PRD §8.5.2)
DATABASE_URL="file:./prdgenz.db"

# AI provider keys — self-host configures keys via env, not the UI (PRD §6.2.2)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
OMNIROUTE_API_KEY=""
TOKENROUTER_API_KEY=""
9ROUTER_API_KEY=""
CUSTOM_API_KEY=""
CUSTOM_BASE_URL=""

# Optional: default provider/model + output language (ID|EN)
AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL=""
AI_DEFAULT_LANGUAGE="EN"
